# Copy this file to ".env" and fill it in.

# Only this computer (default):
PACKSHOT_BIND=127.0.0.1
# Share with colleagues on the same network: use 0.0.0.0 AND set logins below.
# PACKSHOT_BIND=0.0.0.0

# Logins: name:password, separated by commas (no commas or colons inside a password). Required when sharing.
# PACKSHOT_USERS=pieter:choose-a-strong-password,anna:another-strong-password

# Port (default 8080)
# PACKSHOT_PORT=8080
